---
sitemap: false
---
[
{%- for post in site.posts -%}
  {%- capture post_content -%}{{ post.title }} {{ post.tags | join: " " }} {{ post.content | strip_html }}{%- endcapture -%}
{
  "title": {{ post.title | jsonify }},
  "url": {{ post.url | jsonify }},
  "date": {{ post.date | date: "%Y年%-m月%-d日" | jsonify }},
  "snippet": {{ post.description | default: "" | jsonify }},
  "content": {{ post_content | normalize_whitespace | truncate: 8000 | jsonify }}
}{% unless forloop.last %},{% endunless %}
{%- endfor -%}
]
